{
  "expo": {
    "name": "SmartRise",
    "slug": "SmartRise",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-status-bar",
      "expo-secure-store",
      "./plugins/withLocalCmake",
      "@react-native-community/datetimepicker",
      "@react-native-vector-icons/ionicons"
    ],
    "android": {
      "package": "com.anonymous.myApp2",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E4EBFC"
      },
      "permissions": [
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    }
  }
}
