{
  "expo": {
    "name": "SmartRise",
    "slug": "SmartRise",
    "version": "1.0.0",
    "plugins": [
      "expo-status-bar",
      "expo-secure-store",
      "./plugins/withLocalCmake",
      "@react-native-vector-icons/ionicons"
    ],
    "android": {
      "package": "com.anonymous.myApp2",
      "permissions": [
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    }
  }
}
